# Python
__pycache__/
/models/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Database / cache
*.db
*.db-journal

# Streamlit
.streamlit/secrets.toml

# Sessions (autosaved review progress)
.sessions/

# Local secrets (.env holds S2_API_KEY etc.)
.env

# Test / build artifacts
.pytest_cache/
# Repo-local test temp tree (see tests/conftest.py). The system temp dir is not
# usable on every Windows setup, so fixtures keep their scratch files here.
tests/_workspace_tmp/
# Scratch dirs that pytest/pip created directly under the root before conftest
# took over temp handling. Empty and harmless, but they must never be packaged
# or committed.
.pytest_bt/
.pytest_le/
.pytest_tmp/
.piptmp/
_pip_tmp/
pytest-cache-files-*/

# Ad-hoc scratch files. An untracked working tree is shared by every agent in
# this session, so a throwaway probe file must never be able to reach a commit.
.tmp_*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Downloads (PDFs)
Downloads/

.reference/
.venv/
.venv-*/
node_modules/
.web-data/
web/.vite/
!web/dist/
!web/dist/**
# 首页像素基线：before 是冻结的基线（入库），after 每步重新生成（不入库）。
web/e2e-shots/home-after-*
web/e2e-shots/home-before.json
web/e2e-shots/home-after.json
# 本机 esbuild 临时目录不可写时的构建临时区（见 docs/handoff/UI_INTEGRATION_PLAN.md S0）
web/.tmp-build/
artifacts/
deliverables/
.ruff_cache/

# 便携包构建产物（由 scripts/package_windows.py 生成，不入库）
/dist-windows/

# 运行期临时文件（certifi / pip 等在仓库根落下的临时 CA 包）
/tmp*/
cacert.pem
