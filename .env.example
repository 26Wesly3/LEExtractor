# LEExtractor environment template — copy to .env and fill in what you use.
#
#   cp .env.example .env && chmod 600 .env
#
# Rules enforced by the code and the deployment docs:
#   * no real key is ever committed; .env is git-ignored and docker-ignored
#   * a missing optional key degrades a feature, it does not stop the service
#   * a missing LEEXTRACTOR_* directory means "use the default", never "fail"
#   * secrets never reach logs, /api/health or the frontend

# --- Provider credentials (all optional) -----------------------------------
# Without S2_API_KEY Semantic Scholar shares a very tight global rate limit.
S2_API_KEY=
OPENALEX_API_KEY=
SERPAPI_API_KEY=
# Required by the Unpaywall terms of use if you want open-access PDF lookup.
LEEXTRACTOR_UNPAYWALL_EMAIL=

# --- Storage layout (containers use the /data /models /cache /logs volumes) --
# Where user projects are stored. Must be writable: readiness fails without it.
LEEXTRACTOR_DATA_DIR=
# Translation + embedding models. Pre-installed here for the competition host;
# left empty the app downloads them into its default location.
LEEXTRACTOR_MODEL_DIR=
# Cache root (the SQLite cache file lives here). Read-only is tolerated: the app
# falls back to a temporary directory instead of failing the search.
LEEXTRACTOR_CACHE_DIR=
# Log directory. Empty means stdout only; set it to also keep a rotating file
# (5 MiB x 4).
LEEXTRACTOR_LOG_DIR=
LEEXTRACTOR_DOWNLOAD_DIR=

# --- Web API ---------------------------------------------------------------
# Bind address/port. The container uses 0.0.0.0:8012 behind the proxy; a local
# run keeps 127.0.0.1.
LEEXTRACTOR_HOST=127.0.0.1
LEEXTRACTOR_PORT=8012
# Reverse-proxy hostnames the API accepts. EMPTY = local-only (the default).
# Set it to the DuckDNS name, e.g. leextractor-demo.duckdns.org
LEEXTRACTOR_PUBLIC_HOSTS=

# --- Concurrency and model budgets (2 vCPU / 2 GB reference host) ----------
# Concurrent retrieval jobs. 1 is the default; raise to 2 only with a benchmark
# that shows it is safe (docs/decisions/ADR-006).
LEEXTRACTOR_MAX_ACTIVE_JOBS=1
# Provider HTTP concurrency (network wait, cheap) and timeouts in seconds.
LEEXTRACTOR_PROVIDER_CONCURRENCY=4
LEEXTRACTOR_HTTP_CONNECT_TIMEOUT=5
LEEXTRACTOR_HTTP_READ_TIMEOUT=12
# Embedding backend threads/batch. Smaller batches trade latency for memory.
LEEXTRACTOR_EMBEDDING_THREADS=2
LEEXTRACTOR_EMBEDDING_BATCH=8
# Grace period for a running job when the container gets SIGTERM.
LEEXTRACTOR_SHUTDOWN_GRACE=10

# --- Logging ---------------------------------------------------------------
# text (human) or json (one object per line, for log collectors)
LEEXTRACTOR_LOG_FORMAT=text
LEEXTRACTOR_LOG_LEVEL=INFO

# --- Reverse proxy / DuckDNS ----------------------------------------------
# The DuckDNS hostname served by Caddy. The DuckDNS *token* must NOT live here:
# keep it in /etc/duckdns/duckdns.ini (root-owned, mode 600) or in
# /etc/systemd/system/duckdns.service. See DEPLOYMENT.md §DuckDNS.
LEEXTRACTOR_DOMAIN=
